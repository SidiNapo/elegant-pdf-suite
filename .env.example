# =============================================================================
# E-PDF's environment variables
# Copy to .env for local dev. NEVER commit real secrets.
# =============================================================================

# ---- Browser (Vite) — SAFE to expose ----------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."   # anon / publishable key only
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_ADMIN_PATH="ctrl-x9k7m2p4q8n1"             # secret slug for the admin app
# Optional analytics/ads (leave empty until a valid ID is provisioned)
VITE_GA_MEASUREMENT_ID=""
VITE_ADSENSE_CLIENT_ID=""

# ---- Vercel serverless (server-only) ----------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."       # NEVER expose to the browser
CRON_SECRET=""                                  # required by /api/cleanup
ADMIN_PATH="ctrl-x9k7m2p4q8n1"                  # must match VITE_ADMIN_PATH
INDEXNOW_KEY=""                                 # 32-char hex key, same value
                                                # served at /indexnow-key.txt
ADSENSE_PUBLISHER_ID=""                         # real "pub-XXXXXXXXXXXXXXXX"
                                                # (leave empty to disable ads.txt)

# ---- Supabase Edge Function secrets (set via Cloud secrets, NOT .env) ------
# RESEND_API_KEY            transactional email
# CONTACT_TO_EMAIL          inbox for contact form (default contact@e-pdfs.com)
# RESEND_FROM_EMAIL         verified sender (e.g. noreply@e-pdfs.com)
# ALLOWED_ORIGINS           comma-separated list, e.g. https://www.e-pdfs.com
# CONTACT_RATE_LIMIT_SALT   random 32+ char string
# VIEW_HASH_SALT            random 32+ char string
# INDEXNOW_KEY              same value as the Vercel var above
