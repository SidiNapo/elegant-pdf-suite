# ---------- E-Pdf's : Apache / LiteSpeed config for Hostinger ----------
# Place this file at the ROOT of public_html (it ships inside dist/).

Options -MultiViews
RewriteEngine On

# Force https + www (canonical host)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.e-pdfs.com%{REQUEST_URI} [R=301,L]

# SPA fallback: serve index.html ONLY when the request is not a real file/dir
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType application/javascript            .js .mjs
  AddType text/css                          .css
  AddType image/svg+xml                     .svg
  AddType application/manifest+json         .webmanifest
  AddType application/json                  .json
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<FilesMatch "\.(js|mjs|css|png|jpg|jpeg|svg|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "index\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
