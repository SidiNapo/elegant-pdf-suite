{
  "functions": {
    "api/render.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/feed.xml", "destination": "/api/feed" },
    { "source": "/((?!api/|assets/|.*\\.).*)", "destination": "/api/render" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "e-pdfs.com" }],
      "destination": "https://www.e-pdfs.com/:path*",
      "permanent": true
    }
  ]
}
