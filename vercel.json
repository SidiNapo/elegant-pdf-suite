{
  "functions": {
    "api/render.js": {
      "runtime": "@vercel/node@5.1.11",
      "includeFiles": "dist/**"
    },
    "api/sitemap.js": {
      "runtime": "@vercel/node@5.1.11"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|assets/|.*\\.).*)",
      "destination": "/api/render"
    }
  ]
}
